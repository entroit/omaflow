[Unit]
Description=OmaFlow update check
Documentation=https://github.com/entroit/omaflow
After=network-online.target

[Service]
ExecStartPre=+/bin/sh -ec '"$$1" storage-preflight || exec "$$2" storage-preflight' -- "%h/.local/lib/omaflow/current/omaflow" "%h/.local/lib/omaflow/trusted-runner"
ExecStopPost=+/usr/bin/rm -f -- "${XDG_RUNTIME_DIR}/omaflow-storage-${INVOCATION_ID}.json"
Type=oneshot
ExecStart=%h/.local/lib/omaflow/trusted-runner update check
TimeoutStartSec=3min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/omarchy/plugins/entroit.omaflow/.git %h/.local/state/omaflow %t
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
