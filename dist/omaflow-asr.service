[Unit]
Description=OmaFlow configured NeMo speech server
After=graphical-session.target
PartOf=omaflow.service graphical-session.target

[Service]
ExecStartPre=+/bin/sh -ec '"$$1" storage-preflight || exec "$$2" storage-preflight' -- "%h/.local/lib/omaflow/current/omaflow" "%h/.local/lib/omaflow/trusted-runner"
ExecStopPost=+/usr/bin/rm -f -- "${XDG_RUNTIME_DIR}/omaflow-storage-${INVOCATION_ID}.json"
Type=simple
ExecStart=%h/.local/bin/omaflow serve-asr
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=78
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=graphical-session.target
