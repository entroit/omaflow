[Unit]
Description=OmaFlow local dictation daemon
After=graphical-session.target
Requires=omaflow-update-reconcile.service
After=omaflow-update-reconcile.service
PartOf=graphical-session.target

[Service]
ExecStartPre=+/bin/sh -ec '"$$1" storage-preflight || exec "$$2" storage-preflight' -- "%h/.local/lib/omaflow/current/omaflow" "%h/.local/lib/omaflow/trusted-runner"
ExecStopPost=+/usr/bin/rm -f -- "${XDG_RUNTIME_DIR}/omaflow-storage-${INVOCATION_ID}.json"
Type=simple
ExecStart=%h/.local/lib/omaflow/current/omaflow daemon
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t %h/.config/omaflow %h/.local/state/omaflow
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=graphical-session.target
