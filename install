#!/usr/bin/env bash
# OmaFlow bootstrap. Takes a fresh Omarchy machine to a working app:
# packages, the build, the hotkey, then link-local.
#
# It deliberately installs no models. Weights and the ASR runtime are about
# 10 GB and used to stand between a fresh clone and the first screen. Which
# speech model to fetch, and whether this machine can run it, is the user's
# decision: Settings -> Speech lists size, hardware need and licence, and the
# runtime is installed with the first model actually downloaded.
#
# Safe to re-run. Every step checks before it acts, so a run that failed
# halfway can simply be started again.

set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
personal_config="${OMAFLOW_CONFIG:-$config_home/omaflow/config.toml}"

hotkey=""
consume=""
assume_yes=0
dry_run=0
skip_preflight=0
set_hotkey=0

usage() {
  cat <<'EOF'
Usage: ./install [options]

  --hotkey KEY[,KEY...]   Dictation hotkey as XKB keysyms (default: leave as is,
                          or ISO_Level3_Shift,Menu on a first install)
  --consume KEY[,KEY...]  Keysyms to swallow so applications never see them.
                          Menu needs this; a function key does not.
  --skip-preflight        Do not run scripts/preflight.sh first
  --dry-run               Print what would happen and change nothing
  --yes, -y               Do not ask for confirmation
  -h, --help              This message

Examples:
  ./install --hotkey F13
  ./install --hotkey ISO_Level3_Shift,Menu --consume Menu
EOF
}

while (($# > 0)); do
  case "$1" in
  --hotkey)
    if (($# < 2)) || [[ -z $2 || $2 == --* ]]; then
      printf '%s\n' '--hotkey requires KEY[,KEY...].' >&2
      exit 1
    fi
    hotkey="${2:-}"
    set_hotkey=1
    shift 2
    ;;
  --consume)
    if (($# < 2)) || [[ -z $2 || $2 == --* ]]; then
      printf '%s\n' '--consume requires KEY[,KEY...].' >&2
      exit 1
    fi
    consume="${2:-}"
    shift 2
    ;;
  --skip-preflight)
    skip_preflight=1
    shift
    ;;
  --dry-run)
    dry_run=1
    shift
    ;;
  --yes | -y)
    assume_yes=1
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    printf 'Unknown option: %s\n\n' "$1" >&2
    usage >&2
    exit 1
    ;;
  esac
done

if [[ -n $consume ]] && ((set_hotkey == 0)); then
  printf '%s\n' 'Use --consume together with --hotkey to replace the binding.' >&2
  exit 1
fi

say() { printf '\n\033[1m%s\033[0m\n' "$1"; }
step() { printf '  %s\n' "$1"; }
run() {
  if ((dry_run)); then
    printf '  would run: %s\n' "$*"
    return 0
  fi
  "$@"
}

if [[ $EUID -eq 0 ]]; then
  printf 'Run ./install as your normal user, not with sudo. It asks for the\n' >&2
  printf 'password only for the package step.\n' >&2
  exit 1
fi

# Python is part of the supported Omarchy desktop; the hotkey writer needs it.
if ! command -v python3 >/dev/null; then
  printf 'OmaFlow needs Python 3.11+. Install it with: sudo pacman -S python\n' >&2
  exit 1
fi

# A machine with no personal configuration has no model either, so this is the
# only run allowed to declare model setup pending. Re-running the installer on
# a working machine must not disable a model the user already downloaded.
first_install=0
[[ -f $personal_config ]] || first_install=1

# --- 1. Preflight -----------------------------------------------------------
if ((skip_preflight == 0)); then
  say 'Checking this machine'
  if ! "$repo_dir/scripts/preflight.sh" --bootstrap; then
    printf '\nFix the failures above, then run ./install again.\n' >&2
    exit 1
  fi
fi

# --- 2. Work out what is actually missing -----------------------------------
declare -a packages=()
want_package() { pacman -Qq "$1" >/dev/null 2>&1 || packages+=("$1"); }

[[ -x "$HOME/.cargo/bin/cargo" ]] && PATH="$HOME/.cargo/bin:$PATH"
command -v cargo >/dev/null 2>&1 || want_package rust
want_package python
want_package jq
want_package pipewire-audio
want_package wl-clipboard
want_package git

hotkey_file="$config_home/hypr/omaflow-hotkey.lua"
need_hotkey=0
if ((set_hotkey)) || [[ ! -f $hotkey_file ]]; then need_hotkey=1; fi

bindings="$config_home/hypr/bindings.lua"
need_bindings=0
if [[ ! -f $bindings ]] || ! grep -q 'require("omaflow")' "$bindings"; then need_bindings=1; fi

# --- 3. Show the plan and confirm once --------------------------------------
say 'Plan'
((${#packages[@]})) && step "install packages: ${packages[*]}"
((need_hotkey)) && step "write the hotkey to $hotkey_file"
((need_bindings)) && step "add require(\"omaflow\") to $bindings"
step 'build OmaFlow and link it (./link-local)'
step 'download no models; choose a speech model afterwards in Settings -> Speech'

if ((dry_run)); then
  printf '\nDry run, nothing changed.\n'
  exit 0
fi

if ((assume_yes == 0)); then
  printf '\nContinue? [y/N] '
  read -r reply
  [[ $reply == [yY]* ]] || { printf 'Nothing was changed.\n'; exit 1; }
fi

# --- 4. Packages, with one password prompt ----------------------------------
if ((${#packages[@]})); then
  say 'Installing packages'
  sudo -v
  # Keep the sudo timestamp alive across a long pacman run.
  while true; do
    sudo -n true
    sleep 50
    kill -0 "$$" 2>/dev/null || exit
  done 2>/dev/null &
  keepalive=$!
  trap 'kill "$keepalive" 2>/dev/null || true' EXIT

  run sudo pacman -S --needed --noconfirm "${packages[@]}"
fi

# Build once before the shortcut helper writes the complete TOML. link-local
# reuses this build and performs the actual desktop integration.
cargo build --locked --release --manifest-path "$repo_dir/Cargo.toml"
"$repo_dir/target/release/omaflow" config-init

# --- 5. Hotkey --------------------------------------------------------------
if ((need_hotkey)); then
  say 'Writing the hotkey'
  [[ -n $hotkey ]] || hotkey="ISO_Level3_Shift,Menu"
  if ((set_hotkey == 0)) && [[ $hotkey == "ISO_Level3_Shift,Menu" ]]; then
    consume="Menu"
  fi
  python3 "$repo_dir/tools/set_hotkey.py" --keys "$hotkey" --consumed "$consume" --write-only
  step "hotkey: $hotkey"
fi

if ((need_bindings)); then
  say 'Registering the Hyprland adapter'
  mkdir -p "$(dirname "$bindings")"
  if [[ -f $bindings ]]; then
    cp "$bindings" "$bindings.omaflow-backup"
    step "backed up $bindings"
  fi
  printf '\n-- OmaFlow dictation hotkey.\nrequire("omaflow")\n' >>"$bindings"
  step "added require(\"omaflow\") to $bindings"
fi

# --- 6. Build and link ------------------------------------------------------
say 'Building and linking OmaFlow'
if ((first_install)); then
  "$repo_dir/link-local" --no-models
else
  "$repo_dir/link-local"
fi

# --- 7. Tell the truth about the result -------------------------------------
say 'Checking the installation'
problems=0
# Only what an app-only install can promise. The speech server has no model
# yet, so omaflow-asr.service is expected to be down until the setup finishes.
for unit in omaflow.service omaflow-update-check.timer; do
  if systemctl --user is-active --quiet "$unit"; then
    step "$unit is active"
  else
    printf '  FAILED %s is not active. See: journalctl --user -u %s\n' "$unit" "$unit" >&2
    problems=1
  fi
done

if omarchy plugin list --json 2>/dev/null |
  jq -e '.[] | select(.id == "entroit.omaflow" and .enabled)' >/dev/null 2>&1; then
  step 'the bar widget is enabled'
else
  printf '  FAILED the bar widget is not enabled. Run: omarchy plugin enable entroit.omaflow right\n' >&2
  problems=1
fi

# The daily update check runs git in a stripped environment; prove it works now
# rather than letting the panel report a fetch error tomorrow.
if GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -oBatchMode=yes' \
  git -C "$repo_dir" fetch --quiet origin 2>/dev/null; then
  step 'updates can be fetched'
else
  printf '  Updates cannot be fetched without a password. Set up gh or an SSH key,\n' >&2
  printf '  otherwise the panel will show a fetch error instead of new releases.\n' >&2
fi

step 'no model configured yet; choose one in Settings -> Speech'

if ((problems)); then
  printf '\nOmaFlow is installed but not healthy. Fix the failures above.\n' >&2
  exit 1
fi

hotkey_display="$(sed -n 's/^local omaflow_hotkey = { //p' "$hotkey_file" 2>/dev/null |
  tr -d '",' | sed 's/ }//' | sed 's/ / + /g')"
say 'Done'
printf 'OmaFlow is installed. Your hotkey is %s.\n' "${hotkey_display:-your hotkey}"
printf 'Next step: open the OmaFlow panel and pick a speech model in Settings -> Speech.\n'
printf 'It downloads there, with its size and hardware needs shown before you commit.\n'
